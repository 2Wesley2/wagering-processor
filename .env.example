# Copie para .env se precisar mudar algum valor (o Compose lê o .env sozinho,
# do mesmo jeito no PowerShell e no bash). Todos os valores abaixo são
# padrões locais de desenvolvimento, não segredos reais.

# Porta publicada do nginx (API). Troque se 8080 estiver ocupada.
HTTP_PORT=8080
HTTP_BIND=127.0.0.1

# Senhas locais do PostgreSQL (só valem na criação do volume, para o superuser).
POSTGRES_PASSWORD=postgres
OWNER_DB_PASSWORD=wagering_owner
APP_DB_PASSWORD=wagering_app

# Nível de log da aplicação.
LOG_LEVEL=info
