{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun src/main.ts",
    "migrate": "bun src/cli/migrate.ts up",
    "init-queues": "bun src/cli/init-queues.ts",
    "healthcheck": "bun src/cli/healthcheck.ts",
    "boot-check": "bun src/cli/boot-check.ts",
    "sqs:redrive": "bun src/cli/sqs-redrive.ts",
    "outbox:republish": "bun src/cli/outbox-republish.ts",
    "retention:purge": "bun src/cli/retention-purge.ts",
    "verify": "bun src/cli/verify.ts",
    "typecheck": "bunx --bun tsc --noEmit -p tsconfig.json",
    "lint": "bunx --bun eslint .",
    "test:all": "bun scripts/test-all.ts",
    "test:smoke": "bun scripts/smoke.ts",
    "test:report": "bun scripts/test-report.ts",
    "persist:seed": "bun scripts/persist-check.ts seed",
    "persist:check": "bun scripts/persist-check.ts check",
    "format": "bunx --bun prettier --write .",
    "format:check": "bunx --bun prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1167.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.4.2",
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "yaml": "2.9.1"
  }
}
